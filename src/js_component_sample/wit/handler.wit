package hyperlight:bench;

interface handler-interface {
    record request {
        uri: string
    }

    handleevent: func(event: request) -> request;
    fib: func(n: s32) -> u64;
}

interface host-interface {
    print: func(msg: string);
}

world handler-world {
    export handler-interface;
    import host-interface;
}
